\begin_layout Subsection
\begin_inset CommandInset label
LatexCommand label
name "sec: cps_cen"

\end_inset

CPS8256 CEN port
\end_layout

\begin_layout Standard
The CPS8256 CEN port is at E3h.
 
\end_layout

\begin_layout Standard
To read its status,
 write 10h to port E3h.
 Then read port E3h;
 bit 5 is set if the printer is ready.
\end_layout

\begin_layout Standard
To write data,
 write the character to port E8h.
 Then send the following bytes to port E3h:
 5,
 E8h,
 5,
 68h.
 These will toggle the STROBE line.
\end_layout

\begin_layout Subsection
Standalone CEN port
\end_layout

\begin_layout Standard
The standalone CEN port is at ports 84h-87h.
 
\end_layout

\begin_layout Standard
The status is read from IN (84h).
 Bit 0 is 1 if the printer is busy,
 0 if it's ready.
\end_layout

\begin_layout Standard
To write a byte,
 write it to port 87h,
 then to port 85h,
 then to port 87h again.
 The two writes to port 87h toggle the STROBE line.
\end_layout

