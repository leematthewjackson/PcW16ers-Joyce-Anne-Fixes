\begin_layout Standard
Additionally,
 when output is being made,
 the STROBE line must be raised and then lowered;
 otherwise the LocoLink interface does not detect the changed values.
 
\end_layout

\begin_layout Subsection
Link idle
\end_layout

\begin_layout Standard
When the link initially starts,
 the server sends 2 and the client sends 3.
 In the protocol described below,
 this means that the server is listening for the first packet.
\end_layout

\begin_layout Subsection
Sending 
\end_layout

\begin_layout Subsubsection
Sending a byte
\end_layout

\begin_layout Standard
Note:
 Bytes must only be sent in packets - see below.
\end_layout

\begin_layout Itemize
Wait until the value sent by the other end goes from 3 to 1.
\end_layout

\begin_layout Itemize
Send 2 or 3,
 depending whether bit 7 of the byte is 1 or 0.
\end_layout

\begin_layout Itemize
Wait until the value sent by the other end goes from 1 to 3.
\end_layout

\begin_layout Itemize
Send 0 or 1,
 depending whether bit 6 of the byte is 1 or 0.
\end_layout

\begin_layout Itemize
Wait until the value sent by the other end goes from 3 to 1.
\end_layout

\begin_layout Itemize
Send 2 or 3,
 depending whether bit 5 of the byte is 1 or 0.
\end_layout

\begin_layout Itemize
...
 and so on until all the bits of the byte have been sent.
\end_layout

\begin_layout Subsubsection
Sending a packet
\end_layout

\begin_layout Standard
Before sending a packet the value sent by the other end should be 2.
 It may also be 3;
 if so,
 send 3 and wait for it to change to 2.
\end_layout

\begin_layout Itemize
Send 0.
\end_layout

\begin_layout Itemize
Wait until the value received goes from 2 to 3.
\end_layout

\begin_layout Itemize
Send 1.
\end_layout

\begin_layout Itemize
Send one byte:
 the packet type.
\end_layout

\begin_layout Itemize
Send one byte:
 number of following bytes (can be 0 for none).
\end_layout

\begin_layout Itemize
Send any following bytes.
\end_layout

\begin_layout Itemize
Send two bytes:
 the 16-bit CRC of the packet.
\end_layout

\begin_layout Itemize
Wait until the value received goes from 3 to 1.
\end_layout

\begin_layout Itemize
Send 3.
\end_layout

\begin_layout Itemize
Wait until the value received goes from 1 to 3.
\end_layout

\begin_layout Itemize
Send 2.
\end_layout

\begin_layout Subsection
Receiving
\end_layout

\begin_layout Subsubsection
Receiving a byte
\end_layout

\begin_layout Standard
Note:
 Bytes are only received as part of packets - see below.
\end_layout

\begin_layout Itemize
Wait until the value sent by the other end becomes 2 or 3.
 The low bit of the value gives bit 7 of the byte being read.
\end_layout

\begin_layout Itemize
Send 3.
\end_layout

\begin_layout Itemize
Wait until the value sent becomes 0 or 1.
 This gives bit 6 of the byte being read.
\end_layout

\begin_layout Itemize
Send 1.
\end_layout

\begin_layout Itemize
Wait until the value sent becomes 2 or 3.
 This gives bit 5 of the byte being read.
\end_layout

\begin_layout Itemize
Send 3.
\end_layout

\begin_layout Itemize
...
 and so on until all the bits have been read.
\end_layout

\begin_layout Subsubsection
Receiving a packet
\end_layout

\begin_layout Standard
To receive a packet:
\end_layout

\begin_layout Itemize
Wait until the value sent by the other end changes from 3 to 0.
\end_layout

\begin_layout Itemize
Send 3.
\end_layout

\begin_layout Itemize
Wait until the value sent by the other end changes from 0 to 1.
\end_layout

\begin_layout Itemize
Send 1.
\end_layout

\begin_layout Itemize
Receive two bytes (see above).
 The first is the packet type,
 and the second is the number of additional bytes that follow.
\end_layout

\begin_layout Itemize
Receive the additional bytes,
 if any.
\end_layout

\begin_layout Itemize
Receive the 2-byte CRC.
\end_layout

\begin_layout Itemize
Wait for the value sent by the other end to go from 0 or 1 (bit 0 of the last byte) to 3.
\end_layout

\begin_layout Itemize
Send 3.
\end_layout

\begin_layout Itemize
Wait for the value sent by the other end to go from 3 to 2.
\end_layout

