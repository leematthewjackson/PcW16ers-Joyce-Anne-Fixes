\end_layout

\begin_layout LyX-Code
ll_error_t ll_parlink_create(LL_PPLINK *pself, LL_PCALLBACK callback, void
 *cookie);
\end_layout

\begin_layout Standard
Creates the link object.
 The callback parameter will be called when the link has assembled a complete
 packet, and should return an appropriate response packet.
 The 'cookie' is stored, and will be passed unchanged to the callback function.
\end_layout

\begin_layout LyX-Code
ll_error_t ll_parlink_close(LL_PPLINK *pself);
\end_layout

\begin_layout Standard
Shuts down the link.
\end_layout

\begin_layout LyX-Code
ll_error_t ll_parlink_reset(LL_PPLINK pself);
\end_layout

\begin_layout Standard
Resets the parser to the 'idle' state (waiting to transmit a packet), throwing
 away any part-transmitted or part-received packet.
 Used internally if 
\end_layout

\begin_layout LyX-Code
ll_error_t ll_parlink_write(LL_PPLINK pself, unsigned char value);
\end_layout

\begin_layout Standard
The host system writes a value.
 The value is 0-3, as if written by a PCW to its LocoLink interface.
 The caller will need to convert from whichever combination of data or control
 lines provide these signals.
\end_layout

\begin_layout LyX-Code
ll_error_t ll_parlink_read(LL_PPLINK pself, unsigned char *value);
\end_layout

\begin_layout Standard
The host system polls for input.
 The value returned is 0-3, as if received by a PCW on its LocoLink interface.
 The caller will need to convert this to whichever combination of data and
 control lines apply to it.
\end_layout

\begin_layout LyX-Code
unsigned short ll_parlink_crc(unsigned char *packet);
\end_layout

\begin_layout Standard
Calculates the CRC of a LocoLink packet.
 The first byte of the packet is the type, and the second is the length
 of the payload.
 Thus the maximum size of a packet is 259 bytes (type + length + 255 bytes
 payload + 2 bytes CRC) and this should be reflected in the size of the
 array passed in.
\end_layout

\begin_layout Subsubsection
LocoLink client
\end_layout

\begin_layout Standard
The llc_*() functions are wrappers for remote procedure calls over LocoLink.
 Most of the functions are only supported by the PCW servers supplied with
 LocoLink 2.x, LocoLink 16 and LocoLink for Windows; the PC server supplied
 with LocoLink 1.x is very limited in its functionality.
\end_layout

\begin_layout Standard
Most of these functions have an 'unsigned short *result' parameter.
 If the return was LL_E_FAIL, then *result will contain an MSDOS-compatible
 error code (see the Interrupt List for INT 21h / AH = 59h).
 If the return was LL_E_OK, then the value in *result is function-specific.
\end_layout

\begin_layout LyX-Code
ll_error_t llc_connect(LL_PDEV device, LL_END end, const char *client_desc,
 LL_PROTOCOL protocol, LL_PREMOTE *premote, char *server_desc);
\end_layout

\begin_layout Standard
Connect to a LocoLink server.
 The parameters are:
\end_layout

\begin_layout Description
premote Will be initialised with a pointer to the remote session.
\end_layout

\begin_layout Description
device The LibLink device on which the server is – for example, a real parallel
 port with a LocoLink cable plugged into it, a socket being served by the
 JOYCE emulator, or the internal LocoLink server.
\end_layout

\begin_layout Description
end Which end of the LocoLink conection to emulate.
 Usually this would be LL_END_PCW when connecting to a LocoLink 1.x server,
 and LL_END_PC in all other cases.
\end_layout

\begin_layout Description
client_desc Up to 30 characters giving the name of the client program.
 This may be displayed on the server's screen.
\end_layout

\begin_layout Description
protocol Which version of the LocoLink protocol to use.
 If you pass NO_PROTOCOL, llc_connect() will attempt to connect with each
 known protocol version in turn, stopping when it finds one that is accepted.
\end_layout

\begin_layout Description
server_desc Will be set to a string containing the server description (if
 one was supplied) or blank otherwise.
 You should allow space for at least 30 characters plus a terminating null.
\end_layout

\begin_layout LyX-Code
ll_error_t llc_hangup(LL_PREMOTE *premote);
