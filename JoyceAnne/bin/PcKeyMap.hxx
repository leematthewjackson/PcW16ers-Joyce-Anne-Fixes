/* [2.5.5-fix] Keypad keys whose meaning depends on the host's NumLock.
 * With NumLock on they type digits / '.', sent as the main-keyboard
 * codes; with NumLock off they act as the navigation block, sent exactly
 * as the dedicated keys above (KP5 has no navigation meaning and sends
 * its own keypad code). */
static const unsigned int kp_maps[] =
{
//	 SDL key	  NumLock on	   NumLock off
	SDLK_KP0,	  0x45, 0xF045,  0xE070, 0xE0F070,	// Insert
	SDLK_KP1,	  0x16, 0xF016,  0xE069, 0xE0F069,	// End
	SDLK_KP2,	  0x1E, 0xF01E,  0xE072, 0xE0F072,	// Down
	SDLK_KP3,	  0x26, 0xF026,  0xE07A, 0xE0F07A,	// Page Down
	SDLK_KP4,	  0x25, 0xF025,  0xE06B, 0xE0F06B,	// Left
	SDLK_KP5,	  0x2E, 0xF02E,    0x73,   0xF073,
	SDLK_KP6,	  0x36, 0xF036,  0xE074, 0xE0F074,	// Right
	SDLK_KP7,	  0x3D, 0xF03D,  0xE06C, 0xE0F06C,	// Home
	SDLK_KP8,	  0x3E, 0xF03E,  0xE075, 0xE0F075,	// Up
	SDLK_KP9,	  0x46, 0xF046,  0xE07D, 0xE0F07D,	// Page Up
	SDLK_KP_PERIOD,	  0x49, 0xF049,  0xE071, 0xE0F071,	// Delete
};

#define KP_MAP_COUNT (sizeof(kp_maps) / sizeof(kp_maps[0]) / 5)

/* Index of a NumLock-dependent keypad key in kp_maps[], or -1 */
static int pcKeypadIndex(SDLKey keysym)
{
	unsigned n;

	for (n = 0; n < KP_MAP_COUNT; n++)
	{
		if (keysym == kp_maps[n * 5]) return n;
	}
	return -1;
}

/* Work out the bytes the keyboard sends when "keysym" goes down (or up).
 * "numlock" only matters for the keys in kp_maps[]. Writes up to 8 bytes
 * to out[] and returns how many (which may be 0, for Pause going up);
 * returns -1 if the key isn't mapped at all. */
static int pcKeyScancodes(SDLKey keysym, bool down, bool numlock, 
			  unsigned char *out)
{
	unsigned n;
	int len = 0;
	int kp;
	unsigned kc_entry;

	kp = pcKeypadIndex(keysym);
	if (kp >= 0)
	{
		kc_entry = kp_maps[kp * 5 + (numlock ? 1 : 3) + (down ? 0 : 1)];
	}
	else
	{
		for (n = 0; n < sizeof(kc_maps) / sizeof(kc_maps[0]); n += 7)
		{
			if (keysym == kc_maps[n]) break;
		}
		if (n >= sizeof(kc_maps) / sizeof(kc_maps[0])) return -1;
		kc_entry = kc_maps[n + (down ? 1 : 2)];
	}
	switch(kc_entry)	/* Special cases... */
	{
		case 0xFFFFFFFE:	// PrtSc up
		out[0] = 0xE0; out[1] = 0xF0; out[2] = 0x12;
		out[3] = 0xE0; out[4] = 0xF0; out[5] = 0x7C;
		return 6;

		case 0xFFFFFFF9:	// PAUSE down
		out[0] = 0xE1; out[1] = 0x14; out[2] = 0x77; out[3] = 0xE1;
		out[4] = 0xF0; out[5] = 0x14; out[6] = 0xF0; out[7] = 0x77;
		return 8;

		case 0xFFFFFFF8:	// PAUSE up
		return 0;
	}	
	if (kc_entry & 0xFF000000) out[len++] = (kc_entry >> 24) & 0xFF;
	if (kc_entry & 0x00FF0000) out[len++] = (kc_entry >> 16) & 0xFF;
	if (kc_entry & 0x0000FF00) out[len++] = (kc_entry >>  8) & 0xFF;
	out[len++] = kc_entry & 0xFF;
	return len;
}

