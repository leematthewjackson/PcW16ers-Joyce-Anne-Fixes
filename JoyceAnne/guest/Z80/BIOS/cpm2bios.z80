;==========================================================================
; BIOS for CP/M v2.2 in JOYCE guest environment
;==========================================================================
;
IOBYTE	equ	3	;Address of IOBYTE
CDISK	equ	4	;Address of current drive

CR	equ	0Dh
LF	equ	0Ah

;I/O ports
MEMBANK	equ	0ABh	;Current memory bank
MEMFROM	equ	0ACh	;Memory bank to copy from
MEMTO	equ	0ADh	;Memory bank to copy to
EMU_DRV	equ	0AEh	;Emulated drives bitmap
LOADCCP	equ	0B0h	;Load BIOS and CCP
EMU_SD	equ	0B1h	;SELDSK
EMU_RD	equ	0B2h	;READ
EMU_WR	equ	0B3h	;WRITE
EMU_UC1	equ	0B4h	;Fast console output

; Memory banks
HOSTTPA	equ	0FFh	;Host system TPA
HOSTSCR	equ	0FEh	;Host screen
GUESTTPA equ	1	;Guest system TPA

	org	0E600h
BDOS	equ	$-3584
CCP	equ	BDOS-2048
BIOS_STK equ	0FFFEh

	jp	BOOT
WBOOT0:	jp	WBOOT
	jp	CONST
	jp	CONIN
	jp	CONOUT
	jp	LIST
	jp	PUNCH
	jp	READER
	jp	HOME
	jp	SELDSK
	jp	SETTRK
	jp	SETSEC
	jp	SETDMA
	jp	READ
	jp	WRITE
	jp	LISTST
	jp	SECTRAN
	jp	CONOST
	jp	AUXIST
	jp	AUXOST
	jp	0	;DEVTBL
	jp	0	;DEVINI
	jp	DRVTBL
	jp	0	;MULTIO
	jp	0	;FLUSH
	jp	MOVE
	jp	0	;TIME
	jp	SELMEM
	jp	SETBNK
	jp	XMOVE
	jp	0	;USERF
	jp	0	;RESERV1
	jp	0	;RESERV2
	rst	0	;ANNE BCTL
buffer:	defw	0	;Transfer buffer address
	jp	service	;Call to the host
	defb	'JOYCE',1,0
;
biostop:
	defw	dirbuf+100h	;From biostop to FFFF is free.
;
;
; Disk Parameter Headers for up to 16 drives
;
alldrv:	dw	dph_a
	dw	dph_b
	dw	dph_c
	dw	dph_d
	dw	dph_e
	dw	dph_f
	dw	dph_g
	dw	dph_h
	dw	dph_i
	dw	dph_j
	dw	dph_k
	dw	dph_l
	dw	dph_m
	dw	dph_n
	dw	dph_o
	dw	dph_p
;
dph_a:	dw	0	;XLT
	dw	0,0,0	;Workspace
	dw	dirbuf
	dw	dpb_a
	dw	csv_a
	dw	alv_a
